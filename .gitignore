# Airflow local
airflow/logs/
airflow/*.cfg

# Claude Code: só o estado local fica de fora (settings.json do projeto é versionado)
.claude/settings.local.json
.claude/projects/

# SO / editor
.DS_Store
Thumbs.db
.vscode/
