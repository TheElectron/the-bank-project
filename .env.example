# Copie para `.env` (ignorado pelo git) e preencha.

# Credenciais do Kaggle — use UM dos dois formatos.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
KAGGLE_API_TOKEN=

# Opcional: outro YAML de configuração (padrão: configs/global_config.yaml)
# CONFIG_PATH=configs/global_config.yaml

# Opcional: servidor MLflow (make up sobe um em http://localhost:5000). Sem isso, o tracking
# cai num SQLite local em data/mlflow/ (sem servidor, sem Docker).
# MLFLOW_TRACKING_URI=http://localhost:5000

# Pushgateway do Prometheus (publica o resumo de drift). Local: http://localhost:9091; no compose já vem definido.
# PUSHGATEWAY_URL=http://localhost:9091
