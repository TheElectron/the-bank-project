# Copie para `.env` antes de rodar qualquer etapa localmente (nunca commitar
# o `.env` em si — já coberto pelo .gitignore).

# Credenciais da Kaggle API (ver README, "Datalake Setup"). Alternativas
# também suportadas por `src/data/ingestion/datalake_setup.py`: access token
# em `~/.kaggle/access_token`, ou `~/.kaggle/kaggle.json` (formato legacy).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Opcional — tracking URI do MLflow. Sem infra de servidor/Docker Compose
# ainda (ver ROADMAP.md, Fase 4), então o padrão se não definida é o SQLite
# local em datalake/gold/models/mlflow.db (sem servidor).
MLFLOW_TRACKING_URI=
